{
  "protocol_version": "aidb.agent-card/v1",
  "name": "AIDB",
  "description": "Experimental language-agnostic live database and durable home substrate for AI systems.",
  "status": "experimental",
  "capabilities": [
    "durable_memory",
    "knowledge",
    "provenance",
    "sessions",
    "agent_messages",
    "collaboration_requests",
    "change_history",
    "portable_recovery"
  ],
  "collaboration": {
    "supported": true,
    "request_resource_type": "collaboration_request",
    "durable": true
  },
  "discovery": {
    "repository": "https://github.com/usamaizm/AIDB",
    "machine_readable": true
  }
}
